<Window x:Class="ooap_lab5.MainWindow" ResizeMode="NoResize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:щщфз_дфи5"
        mc:Ignorable="d"
        Title="MainWindow" Height="442" Width="946">
    <Grid Margin="0,0,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="152*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="LoadImage" Content="Upload" Height="50" HorizontalAlignment="Left" Margin="17,327,0,0" VerticalAlignment="Top" FontSize="20" Click="LoadImage_Click" Grid.ColumnSpan="2" Width="200"/>
        <Button x:Name="SaveImage" Content="Save" Height="50" HorizontalAlignment="Left" Margin="17,272,0,0" VerticalAlignment="Top" FontSize="20" Click="SaveImage_Click" Grid.ColumnSpan="2" Width="200"/>
        <Button x:Name="GrayScale" Content="Black&amp;White" HorizontalAlignment="Left" Margin="434,327,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="GrayScale_Click"/>
        <ScrollViewer Margin="539,10,12,55" Grid.Column="1">
            <Image x:Name="ImageControl" Stretch="Uniform"/>
        </ScrollViewer>
        <Button x:Name="Blur" Content="Blur" HorizontalAlignment="Left" Margin="434,272,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="Blur_Click"/>
        <Button x:Name="Noise" Content="Noise" HorizontalAlignment="Left" Margin="434,217,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="Noise_Click"/>
        <Button x:Name="Saturation" Content="Saturation" HorizontalAlignment="Left" Margin="434,162,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="Saturation_Click"/>
        <Button x:Name="Sharpen" Content="Sharpen" HorizontalAlignment="Left" Margin="434,107,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="Sharpen_Click"/>
        <Button x:Name="Resize" Content="Resize" HorizontalAlignment="Left" Margin="434,52,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="Resize_Click"/>
        <Button x:Name="CropSquare" Content="CropSquare" HorizontalAlignment="Left" Margin="314,327,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="CropSquare_Click"/>
        <Button x:Name="CropCircle" Content="CropCircle" HorizontalAlignment="Left" Margin="314,272,0,0" VerticalAlignment="Top"  Width="100" Height="50" Grid.Column="1" Click="CropCircle_Click"/>
    </Grid>
</Window>
