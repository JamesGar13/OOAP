<Window x:Class="ooap_lab6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ooap_lab6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ListBox  DisplayMemberPath="Name" x:Name="SceneListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="35,37,400,37" SelectionChanged="SceneListBox_SelectionChanged"/>
        <ListBox x:Name="PerformanceListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="405,37,30,37"/>

    </Grid>
</Window>
